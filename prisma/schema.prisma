// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// tipoAgendamento: "fixo" | "recorrente" | "just_in_time" | "agendado"
// (Enums nao sao suportados pelo conector SQLite, por isso String.
// Validar o valor na camada de aplicacao com um union type TS.)
model Webinar {
  id                            String    @id @default(cuid())
  titulo                        String
  slug                          String    @unique
  videoUrl                      String?   @map("video_url")
  videoFilePath                 String?   @map("video_file_path")
  videoDurationSeconds          Int       @map("video_duration_seconds")
  pitchTimestampSeconds         Int       @map("pitch_timestamp_seconds")
  ctaTexto                      String    @map("cta_texto")
  ctaLink                       String    @map("cta_link")
  // Configuracao da oferta que aparece junto com o CTA - tudo opcional
  ofertaNome                    String?   @map("oferta_nome")
  ofertaTitulo                  String?   @map("oferta_titulo")
  ofertaImagemUrl               String?   @map("oferta_imagem_url")
  ofertaDescricao               String?   @map("oferta_descricao")
  precoOriginal                 Float?    @map("preco_original")
  precoOferta                   Float?    @map("preco_oferta")
  // Texto livre do parcelamento (ex: "10x de R$ 19,90"), mostrado junto do preco
  precoParcelado                String?   @map("preco_parcelado")
  // Minutos de contagem regressiva de urgencia a partir do momento que o CTA aparece
  ctaCountdownMinutos           Int?      @map("cta_countdown_minutos")
  // Segundo do video em que o CTA some (opcional - se nulo, fica ate o fim)
  ctaDesaparecerSegundos        Int?      @map("cta_desaparecer_segundos")
  // Meta/Facebook Pixel ID, injetado na pagina da sala quando configurado
  metaPixelId                   String?   @map("meta_pixel_id")
  // Se falso, o video sempre comeca do zero pra cada espectador (nao pula
  // pro ponto do relogio real); o agendamento (aguardando/encerrado) continua
  // valendo do mesmo jeito independente disso.
  sincronizarVideoComHorario    Boolean   @default(true) @map("sincronizar_video_com_horario")
  // Faixa da audiencia fake exibida na sala - se nulos, usa uma faixa padrao
  audienciaFakeMin              Int?      @map("audiencia_fake_min")
  audienciaFakeMax              Int?      @map("audiencia_fake_max")
  // Aparencia da sala publica. Valores validados na camada de aplicacao.
  temaSala                      String    @default("hotwebinar") @map("tema_sala")
  corPrimaria                   String    @default("#e11d48") @map("cor_primaria")
  corFundo                      String    @default("#fafaf8") @map("cor_fundo")
  corTexto                      String    @default("#18181b") @map("cor_texto")
  fonteSala                     String    @default("Inter") @map("fonte_sala")
  tipoAgendamento               String    @default("fixo") @map("tipo_agendamento")
  // JSON array de horarios "HH:mm", usado quando tipoAgendamento = "fixo"
  horariosFixos                 Json?     @map("horarios_fixos")
  intervaloRecorrenciaMinutos   Int?      @map("intervalo_recorrencia_minutos")
  delayJustInTimeMinutos        Int?      @map("delay_just_in_time_minutos")
  // Usado quando tipoAgendamento = "agendado"
  agendadoDataHoraInicio        DateTime? @map("agendado_data_hora_inicio")
  // Opcional: em branco = repete pra sempre (ate ser pausado). Preenchida,
  // a serie para nessa data.
  agendadoDataHoraFim           DateTime? @map("agendado_data_hora_fim")
  // "nenhuma" | "diaria" | "semanal" | "mensal"
  agendadoRepeticao             String?   @map("agendado_repeticao")
  // Pausa a serie sem mexer no agendamento configurado (retomar so desmarcar)
  agendadoPausado               Boolean   @default(false) @map("agendado_pausado")
  // Opcional: fecha a sala nesse horario do dia mesmo se o video ainda nao
  // acabou (ex: aula das 19h as 21h, mesmo com um video de 3h). Calculado uma
  // vez, ao salvar, a partir do horario de inicio e do horario de fim
  // escolhidos no formulario.
  agendadoDuracaoMaximaSegundos Int?      @map("agendado_duracao_maxima_segundos")
  // --- Agente de suporte com IA (chat flutuante) - ver src/lib/agenteSuporte.ts ---
  agenteIaAtivo                 Boolean   @default(false) @map("agente_ia_ativo")
  agenteNome                    String?   @map("agente_nome")
  agenteFotoUrl                 String?   @map("agente_foto_url")
  // Contexto extra que so o agente ve (nao aparece na sala): diferenciais,
  // bonus, garantia, objecoes comuns e como responder, etc.
  agenteInformacoesProduto      String?   @map("agente_informacoes_produto")
  // Como o agente deve se comportar: formal/informal, calmo/direto, etc.
  agenteTom                     String?   @map("agente_tom")
  // Roteiro/resumo do que acontece na aula, pra o agente responder duvidas
  // sobre o conteudo com seguranca.
  agenteRoteiroAula             String?   @map("agente_roteiro_aula")
  // --- Links de acesso (ver src/lib/linksAcesso.ts) ---
  // Pede nome e email antes de entrar pela sala principal (desligado por padrao)
  exigirCadastro                Boolean   @default(false) @map("exigir_cadastro")
  // Habilita o link /{slug}/jit em webinars de outros tipos. No tipo
  // "just_in_time" a sala principal ja e o cadastro just in time.
  justInTimeAtivo               Boolean   @default(false) @map("just_in_time_ativo")
  // Token secreto do link da sala teste (/{slug}/teste?k=...)
  tokenSalaTeste                String    @unique @default(uuid()) @map("token_sala_teste")
  // Replay: so abre depois da sessao. A liberacao pode ter data marcada e o
  // acesso pode expirar numa data fixa e/ou X horas depois de liberado.
  replayAtivo                   Boolean   @default(false) @map("replay_ativo")
  replayLiberarEm               DateTime? @map("replay_liberar_em")
  replayExpirarEm               DateTime? @map("replay_expirar_em")
  replayDuracaoHoras            Int?      @map("replay_duracao_horas")
  ativo                         Boolean   @default(true)
  criadoEm                      DateTime  @default(now()) @map("criado_em")

  chatMessages ChatMessage[]
  leads        Lead[]
  transcricao  Transcricao?
  comentarios  Comentario[]
  presencas    Presenca[]
  canais       CanalOferta[]

  @@map("webinars")
}

// tipo: "mensagem" | "sistema"
model ChatMessage {
  id                String  @id @default(cuid())
  webinarId         String  @map("webinar_id")
  webinar           Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  timestampSegundos Int     @map("timestamp_segundos")
  nomeAutor         String  @map("nome_autor")
  avatarUrl         String? @map("avatar_url")
  texto             String
  tipo              String  @default("mensagem")
  ordem             Int     @default(0)

  @@index([webinarId])
  @@map("chat_messages")
}

model Lead {
  id              String       @id @default(cuid())
  webinarId       String       @map("webinar_id")
  webinar         Webinar      @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  nome            String
  // Opcional: quem entra pelo chat com nome e WhatsApp, ou como convidado, nao tem email
  email           String?
  telefone        String?
  // Identifica o participante nas paginas publicas (cookie ou ?a= na URL)
  tokenAcesso     String       @unique @default(uuid()) @map("token_acesso")
  // Link do primeiro acesso: chaves de ORIGENS_LEAD em src/lib/linksAcesso.ts
  origem          String       @default("principal")
  utmSource       String?      @map("utm_source")
  utmMedium       String?      @map("utm_medium")
  utmCampaign     String?      @map("utm_campaign")
  utmContent      String?      @map("utm_content")
  utmTerm         String?      @map("utm_term")
  // Sessao do participante: no just in time, cadastro + delay; nos demais
  // tipos, a primeira sessao em que entrou. Referencia pra liberar o replay.
  sessaoEscolhida DateTime?    @map("sessao_escolhida")
  // Slug do CanalOferta pelo qual entrou (?c= na URL), first-touch - igual
  // origem/UTMs, fica gravado no primeiro acesso e nao muda depois.
  canalOferta     String?      @map("canal_oferta")
  entrouEm        DateTime     @default(now()) @map("entrou_em")
  comentarios     Comentario[]
  presencas       Presenca[]

  @@index([webinarId, email])
  @@index([webinarId, telefone])
  @@index([webinarId])
  @@map("leads")
}

// Transcricao do video com tempos, importada de um arquivo de legenda.
// Tabela separada de proposito: o JSON chega a centenas de KB e a pagina
// publica da sala nao deve carregar isso a cada acesso.
model Transcricao {
  id           String   @id @default(cuid())
  webinarId    String   @unique @map("webinar_id")
  webinar      Webinar  @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  // JSON array de { inicio, fim, texto } - inicio/fim em segundos do video
  segmentos    Json
  // "srt" | "vtt"
  formato      String
  nomeArquivo  String?  @map("nome_arquivo")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("transcricoes")
}

// Comentarios reais dos participantes na sala e as respostas do suporte.
// Cada participante ve so os proprios comentarios e as respostas pra ele.
model Comentario {
  id            String       @id @default(cuid())
  webinarId     String       @map("webinar_id")
  webinar       Webinar      @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  leadId        String       @map("lead_id")
  lead          Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // "participante" | "suporte"
  tipo          String       @default("participante")
  nomeAutor     String       @map("nome_autor")
  texto         String
  // Inicio da sessao ao vivo (ISO) ou "replay": separa o chat de cada sessao
  sessao        String
  // Segundo do conteudo em que a mensagem entra na timeline do participante
  videoSegundos Int          @map("video_segundos")
  respondeAId   String?      @map("responde_a_id")
  respondeA     Comentario?  @relation("RespostasComentario", fields: [respondeAId], references: [id], onDelete: Cascade)
  respostas     Comentario[] @relation("RespostasComentario")
  criadoEm      DateTime     @default(now()) @map("criado_em")

  @@index([webinarId, criadoEm])
  @@index([leadId, sessao])
  @@map("comentarios")
}

// Quem esta com a sala aberta: cada aba manda um sinal a cada poucos segundos
model Presenca {
  id            String   @id @default(cuid())
  webinarId     String   @map("webinar_id")
  webinar       Webinar  @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  // Id aleatorio guardado no navegador (localStorage)
  visitanteId   String   @map("visitante_id")
  leadId        String?  @map("lead_id")
  lead          Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  // "sala" | "replay"
  pagina        String
  videoSegundos Int      @map("video_segundos")
  entrouEm      DateTime @default(now()) @map("entrou_em")
  ultimoSinal   DateTime @default(now()) @map("ultimo_sinal")

  @@unique([webinarId, visitanteId])
  @@index([webinarId, ultimoSinal])
  @@map("presencas")
}

// Canal de venda de um webinar (ex: "Live trafego", "SMS organico"): cada um
// tem seu proprio link (mesmos links padrao da sala, com ?c=<slug>) e pode
// sobrescrever qualquer campo da oferta. Campo nulo aqui = usa o valor do
// Webinar (ver resolverOferta em src/lib/canaisOferta.ts) - assim so precisa
// preencher o que muda de canal pra canal, sem duplicar o webinar inteiro.
model CanalOferta {
  id        String  @id @default(cuid())
  webinarId String  @map("webinar_id")
  webinar   Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  nome      String
  // Identificador na URL (?c=slug), unico dentro do webinar
  slug      String

  ofertaNome             String? @map("oferta_nome")
  ofertaTitulo           String? @map("oferta_titulo")
  ofertaImagemUrl        String? @map("oferta_imagem_url")
  ofertaDescricao        String? @map("oferta_descricao")
  precoOriginal          Float?  @map("preco_original")
  precoOferta            Float?  @map("preco_oferta")
  precoParcelado         String? @map("preco_parcelado")
  ctaTexto               String? @map("cta_texto")
  ctaLink                String? @map("cta_link")
  ctaCountdownMinutos    Int?    @map("cta_countdown_minutos")
  ctaDesaparecerSegundos Int?    @map("cta_desaparecer_segundos")
  metaPixelId            String? @map("meta_pixel_id")

  criadoEm DateTime @default(now()) @map("criado_em")

  @@unique([webinarId, slug])
  @@map("canais_oferta")
}

// Membro da equipe: login proprio (email + senha), acesso igual ao admin em
// todas as telas. So a conta admin principal (senha em ADMIN_PASSWORD) pode
// criar ou remover membros - ver exigirAdminPrincipal em src/lib/adminAuth.ts.
// sessionToken vai no cookie de login; remover o membro (deletar a linha) já
// invalida a sessão dele na hora, sem precisar de logout.
model Membro {
  id           String   @id @default(cuid())
  email        String   @unique
  senhaHash    String   @map("senha_hash")
  sessionToken String   @unique @default(uuid()) @map("session_token")
  criadoEm     DateTime @default(now()) @map("criado_em")

  @@map("membros")
}

// Conexao OAuth com um canal do YouTube (retencao real dos videos - ver
// src/lib/youtubeAnalytics.ts). So uma linha (id fixo "singleton"): a
// autorizacao e por canal, nao por webinar - conecta uma vez e vale pra
// qualquer webinar cujo video seja desse canal.
model IntegracaoYoutube {
  id           String   @id @default("singleton")
  refreshToken String   @map("refresh_token")
  canalId      String?  @map("canal_id")
  canalNome    String?  @map("canal_nome")
  conectadoEm  DateTime @default(now()) @map("conectado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("integracao_youtube")
}
